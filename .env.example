# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Django core ─────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=your-ec2-ip,yourdomain.com

# ─── Database ────────────────────────────────────────────────────────────────
# Set DB_ENGINE=sqlite3 for local dev; postgresql for production
DB_ENGINE=postgresql
DB_NAME=midrus_db
DB_USER=midrus_user
DB_PASSWORD=strong-database-password-here
DB_HOST=localhost
DB_PORT=5432

# ─── HTTPS / Security ────────────────────────────────────────────────────────
# Set SECURE_SSL_REDIRECT=True only if nginx is NOT handling the redirect itself
SECURE_SSL_REDIRECT=False
# Set to 31536000 (1 year) once the site is stable on HTTPS
SECURE_HSTS_SECONDS=0
# These default to "not DEBUG" — set explicitly for production clarity
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Reverse proxy / rate limiting ───────────────────────────────────────────
# How many reverse proxies sit in front of gunicorn (nginx = 1). This makes
# rate limits key on the real client IP. Use 0 only if gunicorn is exposed
# directly; leaving it wrong makes every user share ONE login-attempt budget.
NUM_PROXIES=1
# Wrong OTP guesses allowed per user before the code is locked
OTP_MAX_ATTEMPTS=5
# Require every sign-up to accept the Terms & Privacy Policy (accepted_terms=true).
# Leave False until all sign-up forms (web + app) have the consent checkbox.
REQUIRE_TERMS_ACCEPTANCE=False
# How long signed document links stay valid (seconds)
FILE_URL_TTL_SECONDS=3600

# ─── Cloudflare R2 (document storage) ────────────────────────────────────────
# Leave all four blank to fall back to local disk storage (media/) for dev.
# Create the bucket + an API token (Object Read & Write, scoped to this
# bucket) at dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=midrus-documents
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Only set this if you need a non-default endpoint; normally leave unset and
# it's derived from R2_ACCOUNT_ID as https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=

# ─── CORS / CSRF ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ─── Email / SMTP ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Exactly one of these True: TLS (STARTTLS, usually port 587) or SSL (implicit
# TLS, usually port 465). The wrong pair for your port makes the server drop
# the connection instantly (SMTPServerDisconnected) instead of a clear error.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-gmail@gmail.com
# Gmail: use an App Password, not your real password
# Generate at: myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=MIDRUS <your-gmail@gmail.com>
ADMIN_EMAIL=your-admin@gmail.com

# ─── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# Path to the service-account JSON from Firebase Console -> Project Settings
# -> Service Accounts -> Generate new private key. Leave blank to keep push
# notifications logged-only (nothing sent to devices).
FCM_CREDENTIALS_PATH=

# ─── Gunicorn (Procfile) ─────────────────────────────────────────────────────
WEB_CONCURRENCY=3
PORT=8000
